# MongoDB connection (same instance as Yuan-Zzzz.com, separate database)
MONGODB_URI=mongodb://localhost:27018/zimages

# Admin credentials (used by /api/auth/login)
# If ADMIN_PASSWORD starts with "$2", it's treated as a bcrypt hash; otherwise plaintext.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT signing secret (change in production)
JWT_SECRET=change-me-in-production

# Where uploaded files live (relative or absolute). Defaults to ./data
UPLOAD_DIR=./data
